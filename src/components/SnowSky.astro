---
/**
 * 夜空 + 星星 + 飘雪。
 * 整块画在一个 <canvas> 上，内容和交互都不受影响（pointer-events: none）。
 *
 * 想调手感就去 src/config.ts 的 snow 字段，不用改这个文件。
 */
import { site } from '../config';

const { enabled, density, speed, wind, stars } = site.snow;
---

<canvas
  id="snow-sky"
  class="snow-sky"
  aria-hidden="true"
  data-enabled={enabled ? 'true' : 'false'}
  data-density={density}
  data-speed={speed}
  data-wind={wind}
  data-stars={stars}
></canvas>

<script>
  type Flake = {
    layer: number;
    x: number;
    y: number;
    r: number;
    vy: number;
    sway: number;
    phase: number;
    alpha: number;
    drift: number;
  };

  type Star = {
    x: number;
    y: number;
    r: number;
    a: number;
    tw: number;
    phase: number;
  };

  // 三个景深层：远处的雪小、慢、淡；近处的雪稍大、快、亮
  const LAYERS = [
    { share: 0.55, r: [0.45, 0.9], vy: [7, 13], alpha: [0.34, 0.58], sway: [4, 10] },
    { share: 0.31, r: [0.9, 1.5], vy: [13, 22], alpha: [0.42, 0.68], sway: [7, 14] },
    { share: 0.14, r: [1.5, 2.5], vy: [22, 34], alpha: [0.55, 0.85], sway: [10, 20] },
  ] as const;

  const canvas = document.getElementById('snow-sky');

  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d', { alpha: true });

    if (ctx) {
      const config = {
        enabled: canvas.dataset.enabled !== 'false',
        density: clampNumber(Number(canvas.dataset.density), 0.2, 2, 1),
        speed: clampNumber(Number(canvas.dataset.speed), 0.2, 3, 1),
        wind: clampNumber(Number(canvas.dataset.wind), 0, 3, 1),
        stars: clampNumber(Number(canvas.dataset.stars), 0, 3, 1),
      };

      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

      let width = 0;
      let height = 0;
      let dpr = 1;
      let stars: Star[] = [];
      let flakes: Flake[] = [];
      let sprites: HTMLCanvasElement[] = [];
      let rafId = 0;
      let lastTime = 0;
      let running = false;
      let resizeTimer = 0;

      function clampNumber(value: number, min: number, max: number, fallback: number) {
        if (!Number.isFinite(value)) return fallback;
        return Math.min(max, Math.max(min, value));
      }

      const rand = (min: number, max: number) => min + Math.random() * (max - min);

      /** 预渲染一张柔光雪花贴图：每帧只做一次 drawImage，省性能 */
      function makeSprite(radius: number) {
        const size = Math.max(10, Math.ceil(radius * 4));
        const sprite = document.createElement('canvas');
        sprite.width = size;
        sprite.height = size;
        const sctx = sprite.getContext('2d');
        if (!sctx) return sprite;

        const half = size / 2;
        const gradient = sctx.createRadialGradient(half, half, 0, half, half, half);
        gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
        gradient.addColorStop(0.34, 'rgba(242, 249, 255, 0.92)');
        gradient.addColorStop(0.62, 'rgba(220, 236, 255, 0.42)');
        gradient.addColorStop(0.86, 'rgba(208, 228, 255, 0.08)');
        gradient.addColorStop(1, 'rgba(205, 226, 255, 0)');
        sctx.fillStyle = gradient;
        sctx.fillRect(0, 0, size, size);
        return sprite;
      }

      function buildSprites() {
        sprites = LAYERS.map((layer) => makeSprite(layer.r[1]));
      }

      function buildStars() {
        const count = Math.round(clampNumber((width * height) / 5200, 0, Infinity, 0) * config.stars);
        const total = Math.min(320, Math.max(0, count));
        stars = Array.from({ length: total }, () => {
          const bright = Math.random() > 0.88;
          return {
            x: Math.random() * width,
            y: Math.random() * height,
            r: bright ? rand(0.9, 1.6) : rand(0.35, 0.9),
            a: bright ? rand(0.55, 0.95) : rand(0.2, 0.7),
            tw: rand(0.35, 1.25),
            phase: Math.random() * Math.PI * 2,
          };
        });
      }

      function buildFlakes() {
        flakes = [];
        const target = Math.round(clampNumber((width * height) / 5900, 0, Infinity, 0) * config.density);
        const total = Math.min(260, Math.max(18, target));

        for (let index = 0; index < LAYERS.length; index += 1) {
          const layer = LAYERS[index];
          const amount = Math.max(1, Math.round(total * layer.share));
          for (let i = 0; i < amount; i += 1) {
            flakes.push({
              layer: index,
              x: Math.random() * width,
              y: Math.random() * height,
              r: rand(layer.r[0], layer.r[1]),
              vy: rand(layer.vy[0], layer.vy[1]),
              sway: rand(layer.sway[0], layer.sway[1]),
              phase: Math.random() * Math.PI * 2,
              alpha: rand(layer.alpha[0], layer.alpha[1]),
              drift: rand(-0.16, 0.16),
            });
          }
        }
      }

      function resize() {
        width = Math.max(1, window.innerWidth);
        height = Math.max(1, window.innerHeight);
        dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        buildStars();
        if (config.enabled) buildFlakes();
        else flakes = [];
      }

      function update(dt: number, now: number) {
        const speed = config.speed;
        const wind = config.wind;

        for (const flake of flakes) {
          flake.y += flake.vy * speed * dt;

          const sway =
            Math.sin(now * 0.00035 * (0.6 + flake.layer * 0.3) + flake.phase) * flake.sway +
            flake.drift * 26;
          flake.x += sway * wind * dt;

          const margin = flake.r * 4;
          if (flake.y - margin > height) {
            flake.y = -margin;
            flake.x = Math.random() * width;
          }
          if (flake.x < -margin) flake.x = width + margin;
          else if (flake.x > width + margin) flake.x = -margin;
        }
      }

      function draw(now: number, animate: boolean) {
        ctx.clearRect(0, 0, width, height);

        for (const star of stars) {
          const twinkle = animate
            ? 0.62 + 0.38 * Math.sin(now * 0.0009 * star.tw + star.phase)
            : 1;
          ctx.globalAlpha = Math.max(0, star.a * twinkle);
          ctx.fillStyle = '#dde9ff';
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);
          ctx.fill();
        }

        for (const flake of flakes) {
          const sprite = sprites[flake.layer];
          if (!sprite) continue;
          const size = flake.r * 4;
          ctx.globalAlpha = flake.alpha;
          ctx.drawImage(sprite, flake.x - size / 2, flake.y - size / 2, size, size);
        }

        ctx.globalAlpha = 1;
      }

      function frame(now: number) {
        rafId = 0;
        if (!running) return;

        const dt = Math.min((now - lastTime) / 1000 || 0, 0.05);
        lastTime = now;

        update(dt, now);
        draw(now, true);
        rafId = requestAnimationFrame(frame);
      }

      function start() {
        if (running || motionQuery.matches || document.hidden) return;
        running = true;
        lastTime = performance.now();
        rafId = requestAnimationFrame(frame);
      }

      function stop() {
        running = false;
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
      }

      function renderStatic() {
        stop();
        draw(performance.now(), false);
      }

      function boot() {
        buildSprites();
        resize();
        if (motionQuery.matches) {
          renderStatic();
          return;
        }
        start();
      }

      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          resize();
          if (!running) draw(performance.now(), false);
        }, 160);
      });

      window.addEventListener('orientationchange', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          resize();
          if (!running) draw(performance.now(), false);
        }, 220);
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (!motionQuery.matches) start();
      });

      const onMotionChange = () => {
        if (motionQuery.matches) renderStatic();
        else start();
      };

      if (typeof motionQuery.addEventListener === 'function') {
        motionQuery.addEventListener('change', onMotionChange);
      } else if (typeof motionQuery.addListener === 'function') {
        motionQuery.addListener(onMotionChange);
      }

      boot();
    }
  }
</script>
