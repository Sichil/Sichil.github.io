---
import { site } from '../config';
import { url } from '../lib/url';

const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const current = Astro.url.pathname;

function isActive(href: string) {
  const target = url(href);
  if (target === `${base}/`) return current === `${base}/` || current === `${base}`;
  return current.startsWith(target);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url('/')}>
      <svg
        class="brand-mark"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M12 2v20M3.5 7l17 10M20.5 7l-17 10" />
        <path d="M9.5 3.6 12 6l2.5-2.4M9.5 20.4 12 18l2.5 2.4" />
      </svg>
      <span>{site.title}</span>
    </a>

    <nav aria-label="主导航">
      <ul class="nav">
        {
          site.nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
