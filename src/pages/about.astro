---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'about');

if (!entry) {
  throw new Error('缺少 src/content/pages/about.md，请先创建「关于」页内容。');
}

const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description ?? '关于我'}>
  <section class="about">
    <h1 class="page-title">{entry.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>
