---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatISO, getPosts, readingTime } from '../../lib/posts';
import type { Post } from '../../lib/posts';
import { url } from '../../lib/url';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
const minutes = readingTime(post.body);

const repo = __GITHUB_REPOSITORY__;
const editUrl = repo ? `https://github.com/${repo}/edit/main/src/content/posts/${post.id}.md` : null;
---

<BaseLayout
  title={title}
  description={description ?? `${title} — ${formatDate(pubDate)}`}
  type="article"
  publishedTime={pubDate}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        <time datetime={formatISO(pubDate)}>{formatDate(pubDate)}</time>
        <span>{minutes} 分钟读完</span>
        {updatedDate && <span>更新于 {formatDate(updatedDate)}</span>}
        {
          editUrl && (
            <a class="edit-link" href={editUrl} rel="noopener noreferrer" target="_blank">
              在 GitHub 上编辑这篇 →
            </a>
          )
        }
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="上一篇与下一篇">
          {newer && (
            <a href={url(`/posts/${newer.id}/`)}>
              <span class="post-nav-label">上一篇</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          )}
          {older && (
            <a href={url(`/posts/${older.id}/`)}>
              <span class="post-nav-label">下一篇</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    <p style="margin-top: 2.5rem; font-size: 0.875rem">
      <a href={url('/posts/')}>← 回到全部文章</a>
    </p>
  </article>
</BaseLayout>
